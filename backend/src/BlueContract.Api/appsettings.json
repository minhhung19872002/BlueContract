{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console", "Args": { "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {SourceContext}: {Message:lj}{NewLine}{Exception}" } }
    ]
  },
  "LogFile": {
    "Enabled": true,
    "Directory": "logs",
    "RetainedFiles": 30,
    "MaxFileMegabytes": 50
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=blueprocure;Username=blueprocure"
  },
  "Database": {
    "InitializeOnStartup": true
  },
  "Auth": {
    "Issuer": "BlueProcure",
    "Audience": "BlueProcure",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15
  },
  "Seed": {
    "Demo": false,
    "AllowReset": false,
    "AdminPassword": ""
  },
  "Email": {
    "Enabled": true,
    "Host": "localhost",
    "Port": 47125,
    "FromAddress": "no-reply@blueprocure.local",
    "FromName": "Cổng mua sắm trực tuyến"
  },
  "App": {
    "PublicBaseUrl": "http://localhost:47080"
  },
  "Cors": {
    "Origins": []
  },
  "Storage": {
    "Endpoint": "localhost:47900",
    "PublicEndpoint": "",
    "UseSsl": false,
    "AccessKey": "",
    "SecretKey": "",
    "Bucket": "blueprocure"
  },
  "ExternalServices": {
    "GotenbergUrl": "http://localhost:47300"
  },
  "Signing": {
    "DefaultProvider": "MOCK",
    "EnableMockProviders": true,
    "InitialRequiresCa": false,
    "MockRemoteDelaySeconds": 5,
    "TsaUrl": null,
    "VnptSmartCa": { "BaseUrl": null, "ClientId": "", "ClientSecret": "" },
    "ViettelMySign": { "BaseUrl": null, "ClientId": "", "ClientSecret": "" },
    "FptCa": { "BaseUrl": null, "ClientId": "", "ClientSecret": "" }
  },
  "His": {
    "Provider": "Mock",
    "DisplayName": "HIS giả lập",
    "BaseUrl": null,
    "ApiKeyHeader": "X-Api-Key",
    "ApiKey": "",
    "TimeoutSeconds": 30,
    "PullEnabled": false,
    "PullCron": "*/15 * * * *",
    "PullLookbackDays": 3
  },
  "HisInbound": {
    "Clients": [],
    "AllowedIps": [],
    "RateLimitPerMinute": 120,
    "DevEndpoints": false
  },
  "Hangfire": {
    "ServerEnabled": true,
    "DashboardEnabled": false
  },
  "OnlyOffice": {
    "PublicUrl": "http://localhost:47082",
    "InternalUrl": "http://localhost:47082",
    "ApiBaseUrlForEditor": "http://host.docker.internal:5296",
    "JwtSecret": ""
  }
}
