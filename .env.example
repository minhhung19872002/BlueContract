# Copy to .env (scripts/dev-up.* does this automatically). Dev values only — change ALL secrets in production.

ASPNETCORE_ENVIRONMENT=Development

POSTGRES_DB=blueprocure
POSTGRES_USER=blueprocure
POSTGRES_PASSWORD=blueprocure_dev

# S3-compatible object storage (SeaweedFS)
S3_ACCESS_KEY=blueprocure
S3_SECRET_KEY=blueprocure_s3_dev
S3_BUCKET=blueprocure

ONLYOFFICE_JWT_SECRET=onlyoffice_dev_secret_change_me_32chars

# JWT signing key (>= 32 bytes). MUST be replaced in production.
AUTH_SIGNING_KEY=dev-only-signing-key-change-me-0123456789abcdef

# Demo data (spec §12). Set SEED_DEMO=false and SEED_ALLOW_RESET=false in production,
# and give SEED_ADMIN_PASSWORD for the first "admin" account.
SEED_DEMO=true
SEED_ALLOW_RESET=true
SEED_ADMIN_PASSWORD=

# Public URL used in email links
PUBLIC_BASE_URL=http://localhost:47080

# Seq is optional: docker compose --profile seq up -d
SEQ_URL=http://seq:5341

# Host ports (all bound to 127.0.0.1)
WEB_PORT=47080
API_PORT=47081
POSTGRES_PORT=47432
S3_PORT=47900
S3_FILER_UI_PORT=47901
ONLYOFFICE_PORT=47082
GOTENBERG_PORT=47300
MAILPIT_UI_PORT=47025
MAILPIT_SMTP_PORT=47125
SEQ_PORT=47341
