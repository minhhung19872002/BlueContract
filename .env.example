# Copy to .env (scripts/dev-up.* does this automatically). Dev values only — change ALL secrets in production.

ASPNETCORE_ENVIRONMENT=Development

POSTGRES_DB=blueprocure
POSTGRES_USER=blueprocure
POSTGRES_PASSWORD=blueprocure_dev

# S3-compatible object storage (SeaweedFS)
S3_ACCESS_KEY=blueprocure
S3_SECRET_KEY=blueprocure_s3_dev
S3_BUCKET=blueprocure
# S3 admin account (creates the bucket, used by backups). The app account above can only read/write its bucket.
S3_ADMIN_ACCESS_KEY=blueprocure-admin
S3_ADMIN_SECRET_KEY=blueprocure_s3_admin_dev
# Public S3 domain for presigned download URLs (e.g. s3.benhvien.vn). Empty = downloads go through the portal (/api/files/…).
STORAGE_PUBLIC_ENDPOINT=
# Redis shared by API instances (SignalR backplane, signing sessions). Empty = single instance, in-process.
REDIS_CONFIGURATION=redis:6379

ONLYOFFICE_JWT_SECRET=onlyoffice_dev_secret_change_me_32chars
# URL the browser uses to load the editor
ONLYOFFICE_PUBLIC_URL=http://localhost:47082

# JWT signing key (>= 32 bytes). MUST be replaced in production.
AUTH_SIGNING_KEY=dev-only-signing-key-change-me-0123456789abcdef

# Demo data (spec §12). Set SEED_DEMO=false and SEED_ALLOW_RESET=false in production,
# and give SEED_ADMIN_PASSWORD for the first "admin" account.
SEED_DEMO=true
SEED_ALLOW_RESET=true
SEED_ADMIN_PASSWORD=

# Public URL used in email links
PUBLIC_BASE_URL=http://localhost:47080

# Seq is optional: docker compose --profile seq up -d
SEQ_URL=http://seq:5341

# Digital signing (spec §8): MOCK | MOCK_REMOTE | USB_TOKEN | VNPT_SMARTCA | VIETTEL_MYSIGN | FPT_CA.
# Disable the mock providers in production once a real CA is configured (see docs/DEPLOY.md).
SIGNING_DEFAULT_PROVIDER=MOCK
SIGNING_ENABLE_MOCK=true
# RFC 3161 time-stamp authority (recommended in production), e.g. http://tsa.ca.gov.vn — empty = no timestamp
SIGNING_TSA_URL=
# Login attempts per IP per minute (spec §11). E2E runs log in many users from one IP: raise it for them (e.g. 1000).
AUTH_LOGIN_RATE_LIMIT=10

# HIS integration (spec §7): Mock = deterministic demo data; Rest = vendor API (field mapping in appsettings His:*).
HIS_PROVIDER=Mock
HIS_BASE_URL=
HIS_API_KEY=
# ApiKey = send HIS_API_KEY in a header; Login = log in as a HIS service account and send its bearer token
HIS_AUTH_MODE=ApiKey
HIS_USERNAME=
HIS_PASSWORD=
# Periodic pull of warehouse receipts from the HIS (cron, UTC). The push API below works independently.
HIS_PULL_ENABLED=true
HIS_PULL_CRON=*/15 * * * *

# Inbound API for the HIS (docs/HIS_INTEGRATION.md): API key + HMAC-SHA256 secret. MUST be replaced in production.
HIS_INBOUND_CLIENT_NAME=HIS
HIS_INBOUND_API_KEY=his-dev-key
HIS_INBOUND_SECRET=his-dev-secret-change-me-0123456789
# Allowed caller IP or CIDR (empty = any; set it in production, e.g. 10.0.5.0/24)
HIS_INBOUND_ALLOWED_IPS=
HIS_INBOUND_RATE_LIMIT=120
# POST /api/dev/his/simulate-receipt ("Giả lập HIS") — demo/test only, set false in production.
HIS_DEV_ENDPOINTS=true

# Hangfire dashboard at /hangfire (only served when ASPNETCORE_ENVIRONMENT=Development).
HANGFIRE_DASHBOARD=true

# Host ports (all bound to 127.0.0.1)
WEB_PORT=47080
API_PORT=47081
POSTGRES_PORT=47432
S3_PORT=47900
S3_FILER_UI_PORT=47901
ONLYOFFICE_PORT=47082
GOTENBERG_PORT=47300
MAILPIT_UI_PORT=47025
MAILPIT_SMTP_PORT=47125
SEQ_PORT=47341

# Subnet of the compose network (pinned so the API can trust its own proxies). Change only if it clashes with a LAN.
DOCKER_SUBNET=172.28.200.0/24
# Proxies whose X-Forwarded-* the API believes (CIDR). Empty = DOCKER_SUBNET (tls + web containers). Never 0.0.0.0/0.
TRUSTED_PROXY_NETWORK=

# Automatic backup (container 'backup'): daily time (Vietnam), copies kept, folder on the host. BACKUP_TIME empty = off.
BACKUP_TIME=01:30
BACKUP_KEEP=30
BACKUP_DIR=./backups
