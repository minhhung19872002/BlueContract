{
  "openapi": "3.1.1",
  "info": {
    "title": "BlueProcure API",
    "description": "Cổng Quản lý & Thanh toán Mua sắm Hàng hóa Trực tuyến",
    "version": "1.0.0"
  },
  "paths": {
