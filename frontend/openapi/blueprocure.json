          "environment",
          "serverTimeUtc",
          "todayLocal"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          },
          "serverTimeUtc": {
            "type": "string",
